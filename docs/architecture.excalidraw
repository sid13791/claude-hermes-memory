   "link": null,
   "locked": false,
   "text": "memory      add / patch / remove a note\nrecall      search every past chat\nskill       create / edit a how-to recipe\nokf_lookup  read company knowledge\nokf_draft   propose a new company page\nPostToolUse hook shows you a notice:\n  \"Saved to notebook\" / \"Waiting #4\"",
   "originalText": "memory      add / patch / remove a note\nrecall      search every past chat\nskill       create / edit a how-to recipe\nokf_lookup  read company knowledge\nokf_draft   propose a new company page\nPostToolUse hook shows you a notice:\n  \"Saved to notebook\" / \"Waiting #4\"",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
